# Not read by the current local-mode build. Reserved for the Supabase wiring described in docs/SUPABASE.md.
# Only ever put the PUBLIC anon key in browser-exposed variables.
VOVEL_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VOVEL_SUPABASE_ANON_KEY=your-public-anon-key
# NEVER expose this to browser code. Server-side admin scripts only (e.g. account deletion).
# SUPABASE_SERVICE_ROLE_KEY=
